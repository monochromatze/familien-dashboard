# Vorlage für die Stufe Prod. Kopieren nach deploy/prod.env und ein eigenes, anderes Passwort als in QA setzen:
#   cp deploy/prod.env.example deploy/prod.env
# deploy/prod.env steht in .gitignore und kommt nie ins Repo.
# Starten: docker compose -p fd-prod --env-file deploy/prod.env -f deploy/compose.yml up -d --wait
APP_ENV=prod
APP_PORT=8080
# Vorerst nur auf diesem Mac erreichbar. Für den Zugriff im WLAN später auf 0.0.0.0 setzen.
APP_BIND=127.0.0.1
POSTGRES_DB=familiendashboard_prod
POSTGRES_USER=familiendashboard
POSTGRES_PASSWORD=bitte-aendern
