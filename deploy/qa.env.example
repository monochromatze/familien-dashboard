# Vorlage für die Stufe QA. Kopieren nach deploy/qa.env und ein eigenes Passwort setzen:
#   cp deploy/qa.env.example deploy/qa.env
# deploy/qa.env steht in .gitignore und kommt nie ins Repo.
# Starten: docker compose -p fd-qa --env-file deploy/qa.env -f deploy/compose.yml up -d --wait
APP_ENV=qa
APP_PORT=8081
APP_BIND=127.0.0.1
POSTGRES_DB=familiendashboard_qa
POSTGRES_USER=familiendashboard
POSTGRES_PASSWORD=bitte-aendern
