# Vorlage. Kopieren nach deploy/dev.env und dort ein eigenes Passwort setzen:
#   cp deploy/dev.env.example deploy/dev.env
# deploy/dev.env steht in .gitignore und kommt nie ins Repo.
POSTGRES_DB=familiendashboard
POSTGRES_USER=familiendashboard
POSTGRES_PASSWORD=bitte-aendern

# Optional (Standardwerte stehen in compose.yml):
# APP_PORT=8080
# APP_BIND=127.0.0.1
